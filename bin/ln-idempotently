#!/usr/bin/env bash

set -euo pipefail

cd $(dirname $0)/..

backup=false
if [ "${1:-}" = "--backup" ]; then
  backup=true
  shift
fi

if [ "$#" -ne 2 ]; then
  echo "Usage: $0 [--backup] target_path link_path"
  exit 1
fi

target_path=$(realpath "$1")
link_path="$2"

# ターゲットパスが存在するかを検証します。
if [ ! -e "${target_path}" ]; then
  echo "Error: Target path '${target_path}' does not exist."
  exit 1
fi

if [ -L "${link_path}" ]; then
  if [ "$(readlink "${link_path}")" = "${target_path}" ]; then
    exit 0
  fi

  echo "Error: A different symbolic link already exists at '${link_path}'."
  exit 1
fi

if [ -e "${link_path}" ]; then
  # ディストリが /etc/skel から配る .bashrc などは --backup で退避してから置き換える
  if [ "${backup}" != true ]; then
    echo "Error: A different file or link already exists at '${link_path}'."
    exit 1
  fi

  if [ -e "${link_path}.bak" ]; then
    echo "Error: Backup path '${link_path}.bak' already exists."
    exit 1
  fi

  mv "${link_path}" "${link_path}.bak"
  echo "Existing file moved: ${link_path} -> ${link_path}.bak"
fi

ln -s "${target_path}" "${link_path}"
echo "Symbolic link created successfully: ${link_path} -> ${target_path}"
