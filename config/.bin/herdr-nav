#!/usr/bin/env bash
#
# herdr-nav — herdr 側の vim-tmux-navigator 相当
#
# tmux.conf の
#   bind -T NAVIGATOR h if-shell "$is_vim" "send-keys C-w h" "select-pane -L"
# を herdr へ移植したもの。herdr にはユーザー定義キーテーブル (tmux の bind -T) が
# 無いため C-w をナビゲータ prefix にする方式は再現できず、prefix+hjkl を入口にする。
#
# Usage:
#   herdr-nav <left|down|up|right>    config.toml の [[keys.command]] から呼ばれる
#
# jq が無い / process-info が失敗した場合は素のペイン移動にフォールバックする。

set -euo pipefail

dir="${1:?usage: herdr-nav <left|down|up|right>}"
herdr="${HERDR_BIN_PATH:-herdr}"

case "$dir" in
  left) key=h ;;
  down) key=j ;;
  up) key=k ;;
  right) key=l ;;
  *)
    echo "herdr-nav: unknown direction: $dir" >&2
    exit 2
    ;;
esac

# tmux.conf の is_vim と同じ対象集合 (vi/vim/nvim/view/gvim/*diff)
vim_re='^g?(view|l?n?vim?x?)(diff)?$'

# --current はフォーカス中のペインを指す。send-keys はペイン ID を必須引数に取るので、
# 同じ応答に含まれる pane_id を使い回して socket 往復を 1 回に抑える。
pane=""
if command -v jq >/dev/null 2>&1; then
  pane=$("$herdr" pane process-info --current 2>/dev/null |
    jq -r --arg vim "$vim_re" '
      if any(.result.process_info.foreground_processes[]?.name | ascii_downcase; test($vim))
      then .result.process_info.pane_id
      else empty
      end
    ' 2>/dev/null) || pane=""
fi

# nvim ペインには <C-w>hjkl を投げ返し、分割移動できるかどうかは nvim に判断させる。
# nvim が端にいた場合は nvim 側が herdr pane focus を呼び返すので、越境まで完結する。
if [ -n "$pane" ]; then
  exec "$herdr" pane send-keys "$pane" ctrl+w "$key"
fi

exec "$herdr" pane focus --direction "$dir" --current
