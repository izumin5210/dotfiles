#!/usr/bin/env bash
#
# hws — herdr workspace picker (tm の herdr 版)
#
# fzf でローカル workspace + ghq リポジトリ + remote SSH ホストを横断選択して
# workspace を切替/作成する。
#
# Usage:
#   hws           対話ピッカーを起動
#   hws <name>    <name> と一致する workspace を focus。無ければ $PWD で作成
#
# 環境変数:
#   HWS_REMOTE_HOSTS  カンマ区切りの SSH ホスト名 (未設定なら TM_REMOTE_HOSTS を継承)

set -euo pipefail

ICON_HERDR=$''
ICON_CLOUD=$''
ICON_GITHUB=$''

in_herdr() { [[ -n "${HERDR_ENV:-}" ]]; }

ensure_server() {
  herdr workspace list >/dev/null 2>&1 && return 0
  nohup herdr server </dev/null >/dev/null 2>&1 &
  disown
  local i
  for i in {1..30}; do
    herdr workspace list >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  return 1
}

workspaces_json() { herdr workspace list 2>/dev/null; }

list_local_workspaces() {
  local current="${HERDR_WORKSPACE_ID:-}"
  workspaces_json |
    jq -r '.result.workspaces[] | [.workspace_id, .label] | @tsv' |
    while IFS=$'\t' read -r id label; do
      local marker=" "
      [[ "$id" == "$current" ]] && marker=$'\e[1;38;5;208m*\e[m'
      printf "\e[0;32m%s\e[m %b %s\tlocal\t%s\n" "$ICON_HERDR" "$marker" "$label" "$id"
    done
}

list_repos() {
  command -v ghq >/dev/null 2>&1 || return 0
  local existing ghq_root
  existing=$(workspaces_json | jq -r '.result.workspaces[].label' 2>/dev/null || true)
  ghq_root=$(ghq root 2>/dev/null) || return 0
  ghq list | while IFS= read -r repo; do
    local basename="${repo##*/}"
    grep -qxF "$basename" <<<"$existing" && continue
    local display="${repo##github.com/}"
    printf "\e[0;34m%s\e[m   %s\trepo\t%s\t%s\n" "$ICON_GITHUB" "$display" "$basename" "$ghq_root/$repo"
  done
}

list_remote() {
  local hosts="${HWS_REMOTE_HOSTS:-${TM_REMOTE_HOSTS:-}}"
  [[ -z "$hosts" ]] && return 0
  local tmpdir
  tmpdir=$(mktemp -d)
  IFS=',' read -ra host_list <<<"$hosts"
  local host
  for host in "${host_list[@]}"; do
    (
      ssh -o ConnectTimeout=3 -o BatchMode=yes "$host" \
        'zsh -lic "herdr workspace list"' 2>/dev/null |
        jq -r '.result.workspaces[]?.label' 2>/dev/null |
        while IFS= read -r label; do
          printf "\e[0;33m%s\e[m   %s (%s)\t%s\t%s\n" "$ICON_CLOUD" "$label" "$host" "$host" "$label"
        done >"$tmpdir/$host"
    ) &
  done
  wait
  cat "$tmpdir"/* 2>/dev/null || true
  rm -rf "$tmpdir"
}

build_list() {
  {
    list_local_workspaces
    list_repos
  }
  list_remote
}

preview_git_log() {
  local kind=$1 name=$2 path=${3:-}
  local dir=""
  case "$kind" in
    local)
      dir=$(herdr pane list 2>/dev/null |
        jq -r --arg W "$name" '.result.panes[] | select(.workspace_id==$W) | .cwd' |
        head -1)
      ;;
    repo)
      dir="$path"
      ;;
    *)
      echo "(remote workspace)"
      return 0
      ;;
  esac
  [[ -n "$dir" ]] || { echo "(no cwd)"; return 0; }
  git -C "$dir" rev-parse --is-inside-work-tree &>/dev/null || {
    echo "(not a git repo)"
    return 0
  }
  local branch
  branch=$(git -C "$dir" symbolic-ref --short HEAD 2>/dev/null ||
    git -C "$dir" rev-parse --short HEAD)
  printf "\e[1;36m%s\e[m\n\n" "$branch"
  git -C "$dir" log --first-parent --color=always \
    --format='%C(yellow)%h %C(green)%cd%C(auto)%d%n  %C(reset)%s' \
    --date=format:'%Y-%m-%d %H:%M' -n 30
}

focus_or_create() {
  local label=$1 cwd=${2:-$PWD}
  local id
  id=$(workspaces_json |
    jq -r --arg L "$label" '.result.workspaces[] | select(.label==$L) | .workspace_id' |
    head -1)
  if [[ -n "$id" ]]; then
    herdr workspace focus "$id" >/dev/null
  else
    herdr workspace create --cwd "$cwd" --label "$label" --focus >/dev/null
  fi
}

select_and_dispatch() {
  local fzf_opts=(
    --delimiter=$'\t' --with-nth=1 --no-hscroll --no-multi --ansi
    --color 'bg:#303446'
    --preview "$0 __preview {2} {3} {4}"
    --preview-window right:60%
  )

  local selected
  selected=$(build_list | fzf "${fzf_opts[@]}") || true
  [[ -z "$selected" ]] && return 0

  local kind name path
  kind=$(awk -F'\t' '{print $2}' <<<"$selected" | xargs)
  name=$(awk -F'\t' '{print $3}' <<<"$selected" | xargs)
  path=$(awk -F'\t' '{print $4}' <<<"$selected" | xargs)

  case "$kind" in
    local)
      herdr workspace focus "$name" >/dev/null
      in_herdr || exec herdr
      ;;
    repo)
      focus_or_create "$name" "$path"
      in_herdr || exec herdr
      ;;
    *)
      # kind == remote hostname
      exec herdr --remote "$kind"
      ;;
  esac
}

main() {
  if [[ "${1:-}" == "__preview" ]]; then
    shift
    preview_git_log "$@"
    return 0
  fi

  ensure_server || {
    echo "hws: failed to reach herdr server" >&2
    exit 1
  }

  if [[ $# -eq 1 ]]; then
    focus_or_create "$1"
    in_herdr || exec herdr
    return 0
  fi

  select_and_dispatch
}

main "$@"
