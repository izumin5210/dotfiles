# Font settings
font-family = "HackGen Console NF"
font-synthetic-style = "no-bold, no-italic, no-bold-italic"
font-size = 13.5
font-feature = "-calt, -liga, -dlig"
font-thicken = true
font-thicken-strength = 64
adjust-cell-width = 1
adjust-cell-height = 8
cursor-style = block

# Color theme
theme = "Catppuccin Frappe"

# Window settings
background-opacity = 0.95
window-padding-x = 8
window-padding-y = 12
confirm-close-surface = true

# macOS specific settings
macos-option-as-alt = left
macos-titlebar-style = hidden
# macos-window-shadow = true

# shell integration
# ssh-terminfo/ssh-env: リモートに xterm-ghostty の terminfo を入れ、入らない場合だけ
# xterm-256color にフォールバックする。zsh 側で TERM を一律上書きする代わりの措置。
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
